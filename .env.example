# Leave empty to run the demo (everything stays on the phone).
# Set to your magyarotyesz server to share codes with everyone, e.g.
# NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=

# Who runs the service, for the Terms, Privacy policy and Imprint pages.
# Until these are set the pages show a highlighted placeholder.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# Postal address (required for the imprint of a public service in Hungary).
NEXT_PUBLIC_OPERATOR_ADDRESS=
# Optional, shown on the Imprint only when set.
NEXT_PUBLIC_OPERATOR_PHONE=
# Set to true once a lawyer has read the legal texts: removes the "plain-language draft" line.
NEXT_PUBLIC_LEGAL_REVIEWED=
